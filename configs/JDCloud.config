CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn"

CONFIG_TESTING_KERNEL=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

CONFIG_PACKAGE_nginx-full=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_luci-app-openlist2=y

### Aria2配置项 ###

CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-app-aria2=y

CONFIG_ARIA2_OPENSSL=y
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
CONFIG_ARIA2_EXPAT=y
# CONFIG_ARIA2_NOXML is not set
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_METALINK=y
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
# CONFIG_ARIA2_COOKIE is not set
CONFIG_ARIA2_WEBSOCKET=y

### EasyMesh（802.11s 网状组网 + 快速漫游）###

# luci-app-easymesh 不在 luci feed 里，光写下面这行会被 make defconfig 静默丢掉 ——
# 包源码由 scripts/Roc-script.sh 检测到本文件启用它时 clone 进 package/。
CONFIG_PACKAGE_luci-app-easymesh=y
CONFIG_PACKAGE_luci-i18n-easymesh-zh-cn=y

# 简体中文。luci.mk 里 i18n 包的 DEFAULT:=LUCI_LANG_zh_Hans||(ALL&&m)，打开它等于把
# 各 luci 应用的 zh-cn 翻译包一并选中（General.config 里已有的 zh_Hant 同理）。
CONFIG_LUCI_LANG_zh_Hans=y

# easymesh 的运行时依赖。包里的 LUCI_DEPENDS 只生成依赖元数据（装包时由 apk 带上），
# 固件内置的话要在这里显式选上。
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_PACKAGE_batctl-default=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_dawn=y
CONFIG_PACKAGE_luci-proto-batman-adv=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_libiwinfo-lua=y
CONFIG_PACKAGE_bash=y

# 802.11s 需要 wpad 的 mesh 变体：hostapd/Makefile 里 LOCAL_VARIANT=basic 只给 CONFIG_OWE=y
# （没有 CONFIG_MESH），而 qualcommax 的 DEFAULT_PACKAGES 默认点的就是 wpad-basic-mbedtls。
# 换成 mesh 变体（同为 minimal + mbedtls 后端，额外给 CONFIG_AP/CONFIG_MESH），不换 TLS 后端。
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mesh-mbedtls=y

# 注：NSS 的 mesh offload（CONFIG_ATH11K_NSS_MESH_SUPPORT）在本机型上不可用 ——
# mac80211/ath.mk 里该符号 depends on NSS_FIRMWARE_VERSION_11_4，而这里钉的是 12_5，
# 写上去也会被 defconfig 丢掉。easymesh 走 batman-adv + 802.11s，不依赖 NSS offload。
